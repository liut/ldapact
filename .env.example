# ldapact environment configuration
#
# There is no config file. Do NOT edit or source this example directly — it
# carries placeholder values and is tracked by git. Copy it to your own file
# first and edit the copy:
#
#   cp .env.example .env
#
# then export the copy before running ./bin/ldapact:
#
#   set -a; source .env; set +a
#
# Unknown LDAPADM_* variables are ignored. Leave optional variables unset or
# commented out rather than empty: an explicitly empty numeric/boolean value
# fails startup. Full reference: README "Configuration".

# --- Required ---
LDAPADM_BASE_DN=dc=example,dc=com
LDAPADM_BIND_DN=cn=admin,dc=example,dc=com
# LDAPADM_URL and LDAPADM_SERVERS are mutually exclusive; set exactly one.
LDAPADM_URL=ldap://127.0.0.1:389
# LDAPADM_SERVERS=ldap://replica-1:389,ldap://replica-2:389

# --- Optional (defaults shown) ---
LDAPADM_LISTEN=127.0.0.1:8389
LDAPADM_AUTO_NUMBER_DN=
LDAPADM_MIN_VERSION=TLSv1.2
LDAPADM_VERIFY=true
LDAPADM_START_TLS=true
LDAPADM_CERT_EXPIRY_FAIL_CLOSED=true
LDAPADM_SCHEMA_COMPAT=openldap
LDAPADM_TREE_FILTER=(objectClass=*)
LDAPADM_POOL_SIZE=8
LDAPADM_PASSWORD_PLAIN_OVERRIDE=false
LDAPADM_PASSWORD_SCHEME=
LDAPADM_TIMEOUT_MINUTES=30
LDAPADM_ABSOLUTE_TIMEOUT_MINUTES=480
LDAPADM_EXPIRED_ACTION=redirect_to_login
# Session store backend: redis (default) | bbolt | memory.
# LDAPADM_SESSION_STORE=redis
# Redis is required when SESSION_STORE=redis:
LDAPADM_REDIS_URL=redis://127.0.0.1:6379
LDAPADM_REDIS_DB=0
# Leave LDAPADM_DB_PATH unset to auto-select: /var/lib/ldapact/sessions.db,
# or ~/.local/state/ldapact/sessions.db when /var/lib/ldapact does not exist.
# Only used with SESSION_STORE=bbolt.
# LDAPADM_DB_PATH=/var/lib/ldapact/sessions.db
LDAPADM_LOG_LEVEL=info
LDAPADM_TEMPLATES_DIR=

# --- Secrets (resolver chain: env -> 0600 file -> TTY; never logged) ---
# LDAPADM_SESSION_KEY is REQUIRED: base64 of 32 bytes (the AES-256-GCM key
# that encrypts session bind credentials; changing it invalidates sessions).
# Generate: openssl rand -base64 32
# LDAPADM_SESSION_KEY=your-base64-32-byte-key
# LDAPADM_AUTO_NUMBER_PASSWORD=your-auto-number-secret
# LDAPADM_REDIS_PASSWORD=your-redis-secret   (optional; Redis without auth is allowed)
# LDAPADM_AUTO_NUMBER_PASSWORD_FILE=/path/to/0600-file
# LDAPADM_REDIS_PASSWORD_FILE=/path/to/0600-file
# LDAPADM_SESSION_KEY_FILE=/path/to/0600-file
# NOTE: LDAPADM_BIND_PASSWORD is deprecated and ignored — the bind
# credential is entered at the login page instead.
