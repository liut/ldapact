# ldapact environment configuration
#
# There is no config file. Do NOT edit or source this example directly — it
# carries placeholder values and is tracked by git. Copy it to your own file
# first and edit the copy:
#
#   cp .env.example .env
#
# then export the copy before running ./bin/ldapact:
#
#   set -a; source .env; set +a
#
# Unknown LDAPADM_* variables fail startup; empty values are treated as unset
# so defaults apply. Full reference: README "Configuration".

# --- Required ---
LDAPADM_URL=ldap://127.0.0.1:389
LDAPADM_BASE_DN=dc=example,dc=com
LDAPADM_BIND_DN=cn=admin,dc=example,dc=com

# --- Optional (defaults shown) ---
LDAPADM_LISTEN=127.0.0.1:8389
LDAPADM_AUTO_NUMBER_DN=
LDAPADM_MIN_VERSION=TLSv1.2
LDAPADM_VERIFY=true
LDAPADM_START_TLS=true
LDAPADM_CERT_EXPIRY_FAIL_CLOSED=true
LDAPADM_SCHEMA_COMPAT=openldap
LDAPADM_TREE_FILTER=(objectClass=*)
LDAPADM_POOL_SIZE=8
LDAPADM_PASSWORD_PLAIN_OVERRIDE=false
LDAPADM_PASSWORD_SCHEME=
LDAPADM_TIMEOUT_MINUTES=30
LDAPADM_ABSOLUTE_TIMEOUT_MINUTES=480
LDAPADM_EXPIRED_ACTION=retry_bind
# Leave LDAPADM_DB_PATH unset to auto-select: /var/lib/ldapact/sessions.db,
# or ~/.local/state/ldapact/sessions.db when /var/lib/ldapact does not exist.
# LDAPADM_DB_PATH=/var/lib/ldapact/sessions.db
LDAPADM_LOG_LEVEL=info
LDAPADM_TEMPLATES_DIR=

# --- Secrets (resolver chain: env -> 0600 file -> TTY; never logged) ---
# LDAPADM_BIND_PASSWORD=your-secret
# LDAPADM_AUTO_NUMBER_PASSWORD=your-auto-number-secret
# LDAPADM_BIND_PASSWORD_FILE=/path/to/0600-file
# LDAPADM_AUTO_NUMBER_PASSWORD_FILE=/path/to/0600-file
